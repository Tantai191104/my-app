<!-- Modal for editing comment -->
<div class="modal fade" id="editCommentModal-<%= comment._id %>" tabindex="-1" aria-labelledby="editCommentModalLabel-<%= comment._id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-white border-secondary">
      <div class="modal-header">
        <h5 class="modal-title" id="editCommentModalLabel-<%= comment._id %>">Edit Comment</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/comments/<%= player._id %>/comment/<%= comment._id %>?_method=PUT" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="rating-<%= comment._id %>" class="form-label">Rating</label>
            <select class="form-select bg-dark text-white border-secondary" id="rating-<%= comment._id %>" name="rating" required>
              <% for (let i = 1; i <= 3; i++) { %>
                <option value="<%= i %>" <%= i === comment.rating ? 'selected' : '' %>><%= i %></option>
              <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label for="content-<%= comment._id %>" class="form-label">Comment</label>
            <textarea class="form-control bg-dark text-white border-secondary" id="content-<%= comment._id %>" name="content" rows="4" required><%= comment.content %></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>
