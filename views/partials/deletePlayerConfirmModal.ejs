<!-- Delete Modal -->
<div class="modal fade" id="deletePlayerModal-<%= player._id %>" tabindex="-1" aria-labelledby="deleteLabel-<%= player._id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form action="/players/delete/<%= player._id %>?_method=DELETE" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteLabel-<%= player._id %>">Confirm Deletion</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete player "<strong><%= player.playerName %></strong>"?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
      </div>
    </form>
  </div>
</div>
