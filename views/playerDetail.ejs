<div class="container py-5">
  <!-- Player Card -->
  <div class="card shadow-lg bg-secondary bg-opacity-10 text-dark mx-auto rounded-4 mb-5" style="max-width: 1000px; min-height: 500px;">
    <div class="row g-0 align-items-stretch h-100">
      <!-- Hình ảnh -->
      <div class="col-md-5 h-100">
        <img src="<%= player.image %>" alt="Image of <%= player.playerName %>" class="img-fluid rounded-start w-100 h-100"
          style="object-fit: cover; border-right: 1px solid #dee2e6; background-color: #f8f9fa;" />
      </div>

      <!-- Thông tin -->
      <div class="col-md-7 h-100">
        <div class="card-body p-4 d-flex flex-column justify-content-between h-100">
          <h2 class="card-title text-warning fw-bold border-bottom border-3 border-warning pb-2 mb-3 text-center" style="font-size: 2.2rem">
            <%= player.playerName %>
          </h2>

          <div class="fs-5 flex-grow-1">
            <p class="mb-3"><strong>Cost:</strong> $<%= player.cost %>M</p>
            <p class="mb-3">
              <strong>Captain:</strong>
              <span class="badge bg-<%= player.isCaptain ? 'success' : 'secondary' %>">
                <%= player.isCaptain ? 'Yes' : 'No' %>
              </span>
            </p>
            <p class="mb-3"><strong>Information:</strong> <div class="text-dark"><%= player.information %></div></p>
            <p class="mb-3"><strong>Team:</strong>
              <span class="text-success fw-semibold"><%= player.team?.teamName || "N/A" %></span>
            </p>
          </div>

          <div class="mt-3 text-center">
            <a href="/" class="btn btn-outline-primary mx-auto">⬅ Back to all players</a>
          </div>
        </div>
      </div>
    </div>
  </div>

<!-- COMMENTS SECTION -->
<%- include('partials/commentSection', { player }) %>
</div>
